# supermicro-x9-webkvm configuration.
# Copy this file to .env and fill it in. The .env file contains secrets: never publish it.
# Put values with special characters (the password hash!) between single quotes.

# --- BMC --------------------------------------------------------------------------------
# IP address (or name) of the BMC, and a BMC user with administrator rights
BMC_HOST=192.168.1.50
BMC_USER=ADMIN
BMC_PASSWORD='change-me'
# BMC_WEB_SCHEME=http          # X9 web interfaces have very old TLS: keep http
# BMC_WEB_PORT=                # empty = default port of the scheme
# BMC_KVM_PORT=                # empty = the one announced by the BMC (5900)

# --- IPMI (statistics and power control) ---------------------------------------------------
# IPMI_BACKEND=native          # native = pure Python IPMI (pyghmi), nothing else needed
#                              # ipmitool = use the ipmitool command (included in the image)
# Only for IPMI_BACKEND=ipmitool:
# IPMI_INTERFACE=lanplus
# IPMI_CIPHER=3                # X9 boards do not support suite 17, the default of recent ipmitool
# IPMI_INTERVAL=30             # seconds between two sensor readings
# SEL_INTERVAL=300             # seconds between two event log readings
# RETENTION_DAYS=7             # days of history kept

# --- Gateway login -------------------------------------------------------------------------
WEBKVM_USER=admin
# Hash of the gateway password, created with:
#   docker run --rm -it supermicro-x9-webkvm python -m webkvm hash-password
# Keep the single quotes: the hash contains '$' characters.
WEBKVM_PASSWORD_HASH='scrypt$...'
# Alternative (not recommended): the password in plain text
# WEBKVM_PASSWORD=
# WEBKVM_SESSION_HOURS=12
# WEBKVM_POWER_CONTROL=true    # power buttons in the dashboard (false = read only)
# WEBKVM_TRUSTED_PROXY=false   # true behind an HTTPS reverse proxy (X-Forwarded-*)

# --- Prometheus / Zabbix ---------------------------------------------------------------
# Token for /metrics and /api/v1/sensors without login (header "Authorization: Bearer <token>").
# Create it with:  docker run --rm supermicro-x9-webkvm python -m webkvm gen-token
WEBKVM_METRICS_TOKEN='paste-the-token-here'
# WEBKVM_METRICS_PUBLIC=false  # true = /metrics without a token (trusted networks only)

# --- KVM console -----------------------------------------------------------------------
# KVM_IDLE_TIMEOUT=300         # seconds without viewers before the BMC session is closed
# Native VNC port for TigerVNC & co. Password of at most 8 characters (a VNC protocol
# limit). With an empty password the native VNC port stays off.
VNC_ENABLE=true
VNC_PASSWORD='vncpass1'
# VNC_PORT=5900

# --- Ports published on the host (docker-compose.yml) ----------------------------------------
# WEBKVM_HTTP_PORT=8080        # change it if 8080 is already taken on the host
# VNC_HOST_PORT=5900

# LOG_LEVEL=INFO
